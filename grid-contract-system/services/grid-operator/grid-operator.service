[Unit]
Description=Durable grid indexer and keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grid-operator
Group=grid-operator
WorkingDirectory=/opt/grid-operator
EnvironmentFile=/etc/grid-operator.env
ExecStart=/opt/grid-operator/venv/bin/grid-operator run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=grid-operator
ReadWritePaths=/var/lib/grid-operator

[Install]
WantedBy=multi-user.target
