GRID_DB_PATH=/var/lib/grid-operator/operator.sqlite3
GRID_RPC_URL=https://rpc.example.invalid:443
GRID_CHAIN_ID=columbus-5
GRID_DEPLOYMENT_HEIGHT=12345678
# Dedicated grid vault/manager instances. Each instance is always bot_id 1.
GRID_VAULTS=terra1vaultone,terra1vaulttwo
GRID_FINALITY_DEPTH=10
GRID_MAX_ORDERS_PER_BATCH=20
GRID_TX_POLL_SECONDS=6
GRID_TX_TIMEOUT_SECONDS=180
GRID_LOOP_SECONDS=5
GRID_TERRAD=/usr/local/bin/terrad
GRID_KEY_NAME=grid-keeper
GRID_KEYRING_BACKEND=os
GRID_GAS_ADJUSTMENT=1.4
# Set an explicit chain-appropriate fee, for example 250000uluna.
GRID_FEES=250000uluna
