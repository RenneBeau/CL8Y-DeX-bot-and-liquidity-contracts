+fn record_maker_output(
+    storage: &mut dyn Storage,
+    order_id: u64,
+    output: Uint128,
+) -> Result<(), ContractError> {
+    if let Some(mut settlement) = LIMIT_ORDER_SETTLEMENTS.may_load(storage, order_id)? {
+        settlement.cumulative_output = settlement.cumulative_output.checked_add(output)?;
+        LIMIT_ORDER_SETTLEMENTS.save(storage, order_id, &settlement)?;
+    }
+    Ok(())
+}
