@@ -2211,0 +2215,41 @@ fn query_limit_order(deps: Deps, order_id: u64) -> StdResult<LimitOrderResponse>
+fn query_limit_order_settlement(
+    deps: Deps,
+    order_id: u64,
+) -> StdResult<dex_common::pair::LimitOrderSettlementResponse> {
+    use dex_common::pair::{LimitOrderSettlementResponse, LimitOrderSettlementStatus};
+
+    let settlement = crate::state::LIMIT_ORDER_SETTLEMENTS.load(deps.storage, order_id)?;
+    let open = ORDERS.may_load(deps.storage, order_id)?;
+    let parked = EXPIRED_LIMIT_CLAIMS.may_load(deps.storage, order_id)?;
+    let (remaining, claimable_refund, status) = if let Some(order) = open {
+        (
+            order.remaining,
+            Uint128::zero(),
+            LimitOrderSettlementStatus::Open,
+        )
+    } else if let Some(refund) = parked {
+        (
+            refund.remaining,
+            refund.remaining,
+            LimitOrderSettlementStatus::Parked,
+        )
+    } else {
+        (
+            Uint128::zero(),
+            Uint128::zero(),
+            LimitOrderSettlementStatus::Filled,
+        )
+    };
+    Ok(LimitOrderSettlementResponse {
+        order_id,
+        owner: settlement.owner,
+        side: settlement.side,
+        price: settlement.price,
+        initial_remaining: settlement.initial_remaining,
+        remaining,
+        cumulative_output: settlement.cumulative_output,
+        status,
+        claimable_refund,
+    })
+}
+
