GRID_DB_PATH=/var/lib/grid-operator/operator.sqlite3
GRID_RPC_URL=https://rpc.example.invalid:443
GRID_CHAIN_ID=columbus-5
GRID_DEPLOYMENT_HEIGHT=12345678
# Dedicated grid vault/manager instances. Each instance is always bot_id 1.
GRID_VAULTS=terra1vaultone,terra1vaulttwo
GRID_FINALITY_DEPTH=10
GRID_MAX_ORDERS_PER_BATCH=20
GRID_TX_POLL_SECONDS=6
GRID_TX_TIMEOUT_SECONDS=180
GRID_LOOP_SECONDS=5
GRID_TERRAD=/usr/local/bin/terrad
GRID_KEY_NAME=grid-keeper
GRID_KEYRING_BACKEND=os
# Interactive default. The systemd unit instead uses an external signer because
# terrad tx sign - cannot safely share stdin with a file-keyring password.
GRID_TERRAD_HOME=/var/lib/grid-operator/terra
# GRID_SIGNER_COMMAND_JSON=["/usr/local/libexec/grid-external-signer"]
GRID_GAS_ADJUSTMENT=1.4
# Set an explicit chain-appropriate fee, for example 250000uluna.
GRID_FEES=250000uluna

# Swap-only vault keeper (grid-operator keep-swap). The keeper polls grid_status
# and submits permissionless rebalances. One swap vault address per process.
GRID_SWAP_VAULTS=terra1vaultswap
GRID_SWAP_RPC_URL=https://rpc.example.invalid:443
GRID_SWAP_CHAIN_ID=columbus-5
GRID_SWAP_KEY_NAME=grid-keeper
GRID_SWAP_FEES=250000uluna
GRID_SWAP_DEADLINE_SECONDS=120
GRID_SWAP_POLL_SECONDS=15
GRID_SWAP_TX_POLL_SECONDS=2
GRID_SWAP_TX_TIMEOUT_SECONDS=60
GRID_SWAP_CONFIRMATION_BLOCKS=2
GRID_SWAP_STATE_FILE=/var/lib/grid-operator/swap-keeper-state.json

# Discovery keeper (grid-operator keep-discover). One process scans instantiate
# events and keeps every vault it finds: grid-vault-swap (GRID_SWAP_CODE_ID)
# and bot-vault rebalance vaults (GRID_REBALANCE_CODE_ID). Signing is serial
# (one key). Each vault gets its own fail-closed tracker file under
# GRID_SWAP_STATE_DIR. For rebalance vaults the keeper key must match each
# vault's configured keeper address.
GRID_SWAP_CODE_ID=123
GRID_REBALANCE_CODE_ID=456
GRID_SWAP_STATE_DIR=/var/lib/grid-operator/discovery-state
GRID_SWAP_CONFIG_VERSION=1
