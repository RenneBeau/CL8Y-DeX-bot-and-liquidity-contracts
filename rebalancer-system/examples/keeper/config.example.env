# Copy this file to config.env and fill in the values.
# config.env is ignored by Git.

KEEPER_VAULT_ADDRESS=terra1...
KEEPER_LCD_URL=https://terra-classic-lcd.publicnode.com
KEEPER_RPC_URL=https://terra-classic-rpc.publicnode.com:443
KEEPER_CHAIN_ID=columbus-5

# Name stored in the local terrad keyring. Never put a mnemonic here.
KEEPER_KEY_NAME=cl8y-bot-keeper
KEEPER_KEYRING_BACKEND=os
KEEPER_TERRAD=terrad

KEEPER_GAS_PRICES=28.325uluna
KEEPER_GAS_ADJUSTMENT=1.4
KEEPER_SLIPPAGE_BPS=200
KEEPER_MAX_SPREAD=0.05
KEEPER_MAX_TRADE_BPS=2500
KEEPER_DEADLINE_SECONDS=120
KEEPER_POLL_SECONDS=15
